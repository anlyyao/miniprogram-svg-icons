{
  "name": "miniprogram-svg-icons",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "description": "小程序多色图标解决方案 - 支持微信、支付宝、快手、抖音等多平台小程序",
  "scripts": {
    "generate:wechat": "tsx scripts/generate.ts wechat",
    "generate:alipay": "tsx scripts/generate.ts alipay",
    "generate:kuaishou": "tsx scripts/generate.ts kuaishou",
    "generate:xiaohongshu": "tsx scripts/generate.ts xiaohongshu",
    "generate:douyin": "tsx scripts/generate.ts douyin",
    "generate:baidu": "tsx scripts/generate.ts baidu",
    "generate:jd": "tsx scripts/generate.ts jd",
    "generate": "run-s generate:*",
    "build:wechat": "tsx scripts/build.ts wechat",
    "build:alipay": "tsx scripts/build.ts alipay",
    "build:kuaishou": "tsx scripts/build.ts kuaishou",
    "build:xiaohongshu": "tsx scripts/build.ts xiaohongshu",
    "build:douyin": "tsx scripts/build.ts douyin",
    "build:baidu": "tsx scripts/build.ts baidu",
    "build:jd": "tsx scripts/build.ts jd",
    "build:utils": "cd packages/utils && npm run build",
    "build": "run-s build:*",
    "release": "tsx scripts/release.ts",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anlyyao/miniprogram-svg-icons.git"
  },
  "keywords": [
    "miniprogram",
    "svg",
    "icon",
    "multicolor",
    "wechat",
    "alipay",
    "kuaishou",
    "xiaohongshu",
    "douyin",
    "baidu",
    "jd",
    "monorepo"
  ],
  "author": "anlyyao",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/anlyyao/miniprogram-svg-icons/issues"
  },
  "homepage": "https://github.com/anlyyao/miniprogram-svg-icons#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "@types/xmldom": "^0.1.34",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "fs-extra": "^11.3.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "npm-run-all2": "^6.2.0",
    "prettier": "^3.0.0",
    "terser": "^5.46.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "xmldom": "^0.6.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write"
    ]
  }
}
