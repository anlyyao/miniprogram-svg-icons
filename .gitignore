node_modules

package-lock.json
pnpm-lock.yaml

dist

miniprogram_npm

# 忽略各小程序包中生成的文件
# （保留 package.json、README.md、CHANGELOG.md；
#   .changelog/ 存放 PR 维度的 changelog 暂存文件 pr-<number>.md，需纳入版本库，随PR/发版流转）
packages/*/*
!packages/*/package.json
!packages/*/README.md
!packages/*/CHANGELOG.md
!packages/*/.changelog/
!packages/*/.changelog/*
# 保留 utils 工具包源码（不被上面的通配规则误伤）
!packages/utils/
!packages/utils/**

# auto-generated files
web/auto-imports.d.ts
web/components.d.ts
